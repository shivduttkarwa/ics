<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ p.seo.title if p and p.seo else site.title }}</title>
<meta name="description" content="{{ p.seo.description if p and p.seo else site.description }}">
<meta name="theme-color" content="{{ site.theme_color }}">
<meta name="format-detection" content="telephone=no">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/assets/icons/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/icons/crest.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/museo-sans-500.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/museo-sans-700.woff2" as="font" type="font/woff2" crossorigin>
{% set lead = p.body[0].type if p and p.body else "" %}
{% if lead == "hero" %}
<link rel="preload" href="/assets/fonts/ulises-light.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/ulises-light-italic.woff2" as="font" type="font/woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="/assets/css/main.css">
<script src="/assets/js/main.js" defer{% if lead == "hero" %} fetchpriority="high"{% endif %}></script>
<script>
  (function (d) {
    d.classList.add("anim-ready");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("anim-reduced");
    var entry = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    // reached from another of the site's pages (not a reload): the header carries over, still
    try {
      if (document.referrer && new URL(document.referrer).origin === location.origin && (!entry || entry.type !== "reload")) d.classList.add("anim-carried");
      // the pill's width as header.js last measured it, so the bar is laid out right from the first frame
      var tools = sessionStorage.getItem("header-tools");
      if (tools) d.style.setProperty("--header-tools", tools);
    } catch (e) {}
    // a link to a section opens on it, with no smooth scroll down from the top past sections still waiting to reveal
    if (location.hash.length > 1 && (!entry || entry.type === "navigate")) {
      d.style.scrollBehavior = "auto";
      addEventListener("load", function () { d.style.scrollBehavior = ""; });
    }
    addEventListener("load", function () {
      setTimeout(function () { if (!d.hasAttribute("data-anim-live")) d.classList.remove("anim-ready"); }, 800);
    });
    // the page change (_page-transition.less): the entrance waits until the rising edge has passed the hero title (window.pageRevealed)
    var revealed;
    window.pageRevealed = new Promise(function (resolve) { revealed = resolve; });
    if (!("onpagereveal" in window)) revealed();
    addEventListener("pagereveal", function (e) {
      var change = e.viewTransition, pressed = false;
      if (!change) return revealed();
      change.ready.then(function () { setTimeout(revealed, 450); }, revealed);
      // the browser takes no clicks while it plays: a press ends it and the click goes where it was aimed
      var press = function () { pressed = true; change.skipTransition(); revealed(); };
      var click = function (ev) {
        if (!pressed || ev.target !== d) return;
        var hit = document.elementFromPoint(ev.clientX, ev.clientY);
        var target = hit && hit.closest("a[href], button, summary, label, input, select, textarea");
        if (target) target.click();
      };
      addEventListener("pointerdown", press, true);
      addEventListener("click", click, true);
      change.finished.finally(function () {
        removeEventListener("pointerdown", press, true);
        setTimeout(function () { removeEventListener("click", click, true); }, 1000);
      });
    });
  })(document.documentElement);
</script>
<noscript><style>[data-anim]{visibility:visible !important}</style></noscript>
