<section class="stories" data-slider-scope>
  <div class="container">
    <h2 data-anim="split">{{ value.title | safe }}</h2>
    <div class="stories__controls" data-anim="reveal">
      <div class="stories__tabs">
        {% for story in value.stories %}
        <button class="btn stories__tab" type="button" data-slider-tab aria-current="{% if loop.first %}true{% else %}false{% endif %}">{{ story.tag }}</button>
        {% endfor %}
      </div>
      <div class="stories__nav">
        <p class="stories__count" aria-hidden="true"><span data-slider-current>01</span> / <span data-slider-total>{% if value.stories | length < 10 %}0{% endif %}{{ value.stories | length }}</span></p>
        <div class="arrows">
          <button class="arrow-btn arrow-btn--prev" type="button" aria-label="Previous story" data-slider-prev><svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></button>
          <button class="arrow-btn arrow-btn--next" type="button" aria-label="Next story" data-slider-next><svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"></use></svg></button>
        </div>
      </div>
    </div>
    <div class="stories__slider swiper" data-slider data-slider-mode="snap" data-slider-rewind data-slider-gap="20">
      <ul class="stories__list swiper-wrapper" data-anim-group="rise">
        {% for story in value.stories %}
        <li class="story swiper-slide" data-story>
          <div class="story__media">
            <div class="story__frame" data-anim-parallax-trigger><div class="story__layer" data-anim="parallax">{% set img = story.image %}{% set cls = "story__img" %}{% include "snippets/image.njk" %}</div></div>
            {% if story.image_secondary %}<div class="story__frame story__frame--more" data-story-more data-anim-parallax-trigger><div class="story__layer" data-anim="parallax">{% set img = story.image_secondary %}{% set cls = "story__img" %}{% include "snippets/image.njk" %}</div></div>{% endif %}
          </div>
          <div class="story__copy" data-story-copy>
            <h3>{{ story.title | safe }}</h3>
            {% if story.lead %}<p class="story__lead">{{ story.lead }}</p>{% endif %}
            {% if story.summary %}<p class="story__summary" data-story-less>{{ story.summary }}</p>{% endif %}
            {% if story.story %}
            <div class="story__full rich-text" data-story-more>{{ story.story | safe }}</div>
            <button class="btn btn-moss story__toggle" type="button" aria-expanded="false" data-story-toggle data-story-close="Close"><span class="btn__dot" aria-hidden="true"><svg class="icon"><use href="#icon-arrow-right"></use></svg></span><span class="btn__label">{{ story.button_label }}</span></button>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
