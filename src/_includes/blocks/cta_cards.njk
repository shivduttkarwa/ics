<section class="cta-cards">
  <div class="container">
    {% if value.title %}<h2 data-anim="split">{{ value.title | safe }}</h2>{% endif %}
    <div class="cta-cards__list" data-anim-group="rise">
      {% for card in value.cards %}
      <article class="cta-cards__card cta-cards__card--{{ card.theme | default('white') }}">
        <div class="cta-cards__media">
          {% set img = card.image %}{% set cls = "cta-cards__img" %}{% include "snippets/image.njk" %}
        </div>
        <div class="cta-cards__body">
          <div class="cta-cards__copy">
            <h3>{{ card.title | safe }}</h3>
            {% if card.text %}<p>{{ card.text }}</p>{% endif %}
          </div>
          {% set btn = card.button %}{% include "snippets/button.njk" %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
