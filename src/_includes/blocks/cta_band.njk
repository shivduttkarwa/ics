<section class="cta-band{% if value.height %} cta-band--{{ value.height }}{% endif %}" data-anim-parallax-trigger>
  <div class="cta-band__media" aria-hidden="true" data-anim="reveal" data-anim-type="zoom-out">
    <div class="cta-band__layer" data-anim="parallax">
      <picture class="cta-band__picture">
        {% if value.image_mobile %}<source media="(max-width: 767.98px)" srcset="{{ value.image_mobile.src }}" width="{{ value.image_mobile.width }}" height="{{ value.image_mobile.height }}">{% endif %}
        <img class="cta-band__img" src="{{ value.image.src }}"{% if value.image.srcset %} srcset="{{ value.image.srcset }}" sizes="100vw"{% endif %} alt="" width="{{ value.image.width }}" height="{{ value.image.height }}" loading="lazy" decoding="async">
      </picture>
      {% if value.video %}<video class="cta-band__video" src="{{ value.video.src }}" poster="{{ value.video.poster | default(value.image.src) }}" muted loop playsinline preload="none" data-ambient></video>{% endif %}
    </div>
  </div>

  <div class="cta-band__inner container">
    <div class="cta-band__body">
      {% if value.eyebrow %}<p class="cta-band__eyebrow" data-anim="reveal">{{ value.eyebrow }}</p>{% endif %}
      <h2 data-anim="split">{{ value.title | safe }}</h2>
      {% if value.text %}<p class="cta-band__text" data-anim="reveal">{{ value.text }}</p>{% endif %}
      <div class="cta-band__buttons" data-anim="reveal">
        {% set btn = value.button %}{% include "snippets/button.njk" %}
        {% set btn = value.button_secondary %}{% set plain = true %}{% include "snippets/button.njk" %}{% set plain = false %}
      </div>
    </div>
  </div>
</section>
