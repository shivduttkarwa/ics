<section class="hero rounded-foot" data-anim-parallax-trigger>
  <div class="hero__media" aria-hidden="true" data-anim="reveal" data-anim-type="zoom-out" data-anim-tier="hero" data-anim-order="0" data-anim-landed="0.8">
    <div class="hero__layer" data-anim="parallax" data-anim-start="top top" data-anim-disable-mobile>
      <picture class="hero__picture">
        {% if value.image_mobile %}<source media="(max-width: 991.98px)" srcset="{{ value.image_mobile.src }}">{% endif %}
        <img class="hero__img" src="{{ value.image.src }}"{% if value.image.srcset %} srcset="{{ value.image.srcset }}" sizes="100vw"{% endif %} alt="" width="{{ value.image.width }}" height="{{ value.image.height }}" fetchpriority="high" decoding="async">
      </picture>
      {% if value.video %}<video class="hero__video" src="{{ value.video.src }}" poster="{{ value.video.poster | default(value.image.src) }}" muted loop playsinline preload="none" data-ambient></video>{% endif %}
    </div>
    <div class="hero__shade"></div>
    <div class="hero__dim"></div>
  </div>

  <div class="hero__body container">
    <div class="hero__lead">
      <h1 data-anim="split" data-anim-tier="hero" data-anim-order="1" data-anim-stagger="0.2">{{ value.title | safe }}</h1>
    </div>
    <div class="hero__more">
      {% if value.text %}<p class="hero__text" data-anim="reveal" data-anim-type="fade-up-soft" data-anim-tier="hero" data-anim-order="2" data-anim-lead="0">{{ value.text }}</p>{% endif %}
      {% if value.button and value.button.text %}
      <div class="hero__buttons" data-anim="reveal" data-anim-type="fade-up-soft" data-anim-tier="hero" data-anim-order="2" data-anim-delay="0.2">
        {% set btn = value.button %}{% include "snippets/button.njk" %}
      </div>
      {% endif %}
    </div>
    {% if value.actions %}
    <div class="hero__actions" data-anim="reveal" data-anim-type="fade" data-anim-tier="hero" data-anim-order="3" data-anim-landed="0.6">
      {% for btn in value.actions %}{% set plain = true %}{% include "snippets/button.njk" %}{% endfor %}{% set plain = false %}
    </div>
    {% endif %}
  </div>

  {% if value.video_card %}
  <a class="hero__card"{% if value.video_card.url %} href="{{ value.video_card.url }}"{% endif %} data-anim="reveal" data-anim-type="from-right-edge" data-anim-tier="hero" data-anim-order="5" data-anim-lead="1.2">
    {% set img = value.video_card.image %}{% set cls = "hero__card-img" %}{% include "snippets/image.njk" %}
    <span class="hero__card-label"><svg class="icon" aria-hidden="true"><use href="#icon-play"></use></svg>{{ value.video_card.label }}</span>
  </a>
  {% endif %}
</section>
