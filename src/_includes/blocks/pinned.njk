<section class="pinned{% if value.theme == 'beach' %} pinned--beach{% endif %} rounded-foot">
  <div class="pinned__inner container">
    <h2 data-anim="split" data-anim-tier="secondary">{{ value.title | safe }}</h2>
    <div class="pinned__aside">
      {% if value.text %}<p class="pinned__text" data-anim="reveal" data-anim-type="fade-up-soft" data-anim-tier="secondary">{{ value.text }}</p>{% endif %}
      {% if value.button and value.button.text %}<div class="pinned__button" data-anim="reveal" data-anim-type="fade-up-soft" data-anim-tier="secondary">{% set btn = value.button %}{% include "snippets/button.njk" %}</div>{% endif %}
    </div>
  </div>
</section>
