<section class="announcement rounded-foot">
  <div class="announcement__sheet" data-anim="tuck" data-anim-wait="40" data-anim-run="120" data-anim-back="50">
    <div class="container announcement__inner">
      <p class="announcement__text"><span class="announcement__label">{{ value.label }}</span> <span class="announcement__message">{{ value.text }}</span></p>
      {% set btn = value.button %}{% include "snippets/button.njk" %}
    </div>
  </div>
</section>
