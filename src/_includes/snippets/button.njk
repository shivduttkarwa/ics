{% if btn and btn.text %}<a class="btn btn-{{ btn.style | default('moss') }}{% if btn.size == 'small' %} btn-sm{% endif %}{% if btn.icon == 'arrow' or btn.icon == 'arrow-angle' %} btn--arrow{% elif btn.icon == 'open' %} btn--open{% endif %}"{% if btn.url %} href="{{ btn.url }}"{% endif %}{% if anim_item %} data-anim-item{% endif %}>{% if not plain and btn.icon != 'arrow' and btn.icon != 'arrow-angle' and btn.icon != 'none' %}<span class="btn__dot" aria-hidden="true"><svg class="icon"><use href="#icon-arrow-right"></use></svg></span>{% endif %}<span class="btn__label">{{ btn.text }}</span>{% if btn.icon == 'arrow' %}<svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>{% elif btn.icon == 'arrow-angle' %}<svg class="icon btn__angle" aria-hidden="true"><use href="#icon-angle-solid"></use></svg><svg class="icon btn__arrow" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>{% endif %}</a>{% endif %}
